        float3 position = _79.camera.xyz + (direction * (0.5 * (start + end)));
        float extinction = _79.medium.x * exp((-fast::max(position.z - _79.medium.z, 0.0)) * _79.medium.y);
        float kept = exp((-extinction) * (end - start));
