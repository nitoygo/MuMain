static inline __attribute__((always_inline))
float3 PointLightGlow(thread const float3& position, constant DynamicLights& _390)
{
    float3 glow = float3(0.0);
    uint count = min(_390.dynamicLightCount, 32u);
    for (uint i = 0u; i < count; i++)
