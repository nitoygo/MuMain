static inline __attribute__((always_inline))
float CloudLight(thread const float2& xy, thread const float4& parameters, thread const float2& offset)
{
    if (parameters.x <= 0.0)
    {
        return 1.0;
    }
    float2 p = (xy + offset) * parameters.y;
    float2 param = p;
    float2 param_1 = (p * 2.0299999713897705078125) + float2(17.1000003814697265625);
    float2 param_2 = (p * 4.070000171661376953125) + float2(31.700000762939453125);
    float cover = ((0.550000011920928955078125 * CloudNoise(param)) + (0.300000011920928955078125 * CloudNoise(param_1))) + (0.1500000059604644775390625 * CloudNoise(param_2));
    float threshold = 1.0 - parameters.z;
    float cloud = smoothstep(threshold - 0.119999997317790985107421875, threshold + 0.119999997317790985107421875, cover);
    return 1.0 - (parameters.x * cloud);
