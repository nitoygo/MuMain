    float3 ndc = clip.xyz / float3(clip.w);
    float2 uv = float2((ndc.x * 0.5) + 0.5, 0.5 - (ndc.y * 0.5));
    if ((any(uv < float2(0.0)) || any(uv > float2(1.0))) || (ndc.z >= 1.0))
    {
