static inline __attribute__((always_inline))
float3 WorldAt(thread const float2& uv, thread const float& depth, constant FogUniforms& _79)
{
    float4 world = _79.inverseViewProjection * float4((uv.x * 2.0) - 1.0, 1.0 - (uv.y * 2.0), depth, 1.0);
    return world.xyz / float3(world.w);
}

static inline __attribute__((always_inline))
float SliceGrowth(constant FogUniforms& _79)
{
    return log(_79.color.w / _79.camera.w);
}

static inline __attribute__((always_inline))
float PhaseRatio(thread const float& cosine, thread const float& g)
{
    float denominator = (1.0 + (g * g)) - ((2.0 * g) * cosine);
    return (1.0 - (g * g)) / (denominator * sqrt(denominator));
}

static inline __attribute__((always_inline))
float Dither(thread const float2& cell, thread const float& slice)
{
    float2 p = cell + float2(slice * 5.588237762451171875);
