static inline __attribute__((always_inline))
float CloudHash(thread const float2& p)
{
    return fract(sin(dot(p, float2(127.09999847412109375, 311.70001220703125))) * 43758.546875);
}

static inline __attribute__((always_inline))
float CloudNoise(thread const float2& p)
{
    float2 cell = floor(p);
    float2 f = fract(p);
    float2 u = (f * f) * (float2(3.0) - (f * 2.0));
    float2 param = cell;
    float a = CloudHash(param);
    float2 param_1 = cell + float2(1.0, 0.0);
    float b = CloudHash(param_1);
    float2 param_2 = cell + float2(0.0, 1.0);
    float c = CloudHash(param_2);
    float2 param_3 = cell + float2(1.0);
    float d = CloudHash(param_3);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
