kernel void main0(constant FogUniforms& _79 [[buffer(0)]], constant DynamicLights& _390 [[buffer(1)]], depth2d<float> sunShadowMap [[texture(0)]], texture3d<float, access::write> volume [[texture(1)]], sampler sunShadowSampler [[sampler(0)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
