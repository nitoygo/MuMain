static inline __attribute__((always_inline))
float3 WorldAt(thread const float2& uv, thread const float& depth, constant FogUniforms& _47)
{
    float4 world = _47.inverseViewProjection * float4((uv.x * 2.0) - 1.0, 1.0 - (uv.y * 2.0), depth, 1.0);
    return world.xyz / float3(world.w);
}

static inline __attribute__((always_inline))
float SliceGrowth(constant FogUniforms& _47)
{
    return log(_47.color.w / _47.camera.w);
}

static inline __attribute__((always_inline))
void _main(thread const uint3& pixel, constant FogUniforms& _47, texture2d<float> sceneDepth, sampler depthSampler, texture3d<float> fogVolume, sampler volumeSampler, texture2d<float, access::write> fogLayer)
{
    if (any(pixel.xy >= _47.target.xy))
    {
        return;
    }
    float2 uv = (float2(pixel.xy) + float2(0.5)) / float2(_47.target.xy);
    float depth = sceneDepth.sample(depthSampler, uv, level(0.0)).x;
    float2 param = uv;
    float param_1 = depth;
    float _distance = length(WorldAt(param, param_1, _47) - _47.camera.xyz);
    float firstEnd = _47.camera.w * exp(SliceGrowth(_47) / float(_47.size.z));
    if ((depth < 1.0) && (_distance < firstEnd))
    {
        float4 first = fogVolume.sample(volumeSampler, float3(uv, 0.5 / float(_47.size.z)), level(0.0));
        float4 storeTemp = mix(float4(0.0, 0.0, 0.0, 1.0), first, float4(_distance / firstEnd));
        fogLayer.write(storeTemp, uint2(pixel.xy));
        return;
    }
    float along = (depth >= 1.0) ? 1.0 : fast::clamp(log(_distance / _47.camera.w) / SliceGrowth(_47), 0.0, 1.0);
    float slice = along - (0.5 / float(_47.size.z));
    float4 storeTemp_1 = fogVolume.sample(volumeSampler, float3(uv, slice), level(0.0));
    fogLayer.write(storeTemp_1, uint2(pixel.xy));
}

kernel void main0(constant FogUniforms& _47 [[buffer(0)]], texture2d<float> sceneDepth [[texture(0)]], texture3d<float> fogVolume [[texture(1)]], texture2d<float, access::write> fogLayer [[texture(2)]], sampler depthSampler [[sampler(0)]], sampler volumeSampler [[sampler(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
